%%% Diagramas del documento %%%
%
% La clase ya carga tikz y graphicx; acá se agregan las bibliotecas y los estilos compartidos por los
% diagramas de los capítulos, para que todos usen la misma tipografía, los mismos redondeos y las mismas
% puntas de flecha. Los diagramas viven en Figures/Capitulos/<NN-Capitulo>/ y se traen con \input.

\ProvidesPackage{Configurations/13-Figuras}

\usetikzlibrary{arrows.meta, positioning, fit, calc, backgrounds}

% Especificador [H] para las figuras que tienen que quedar exactamente donde se las trae con \input. Un
% flotante que salta al principio de la página siguiente corta el párrafo que viene a continuación.
\RequirePackage{float}

% Con [H], un flotante que no entra pasa a la página siguiente. Con \flushbottom (el valor por defecto a dos
% caras) el hueco que deja se repartía entre los párrafos y aparecían espacios en blanco en medio del texto;
% \raggedbottom lo deja al pie de la página.
\raggedbottom

% \FloatBarrier: las tablas grandes (estado del arte) flotan para no dejar media página vacía, pero no pueden
% pasar de la subsección en la que se las trae. La opción section pone además una barrera antes de cada sección,
% para que los flotantes que no van con [H] no pasen a la sección siguiente.
\RequirePackage[section]{placeins}

% Una página que solo tiene flotantes los ubica arriba, como las demás páginas, y no centrados en vertical.
\makeatletter
\setlength{\@fptop}{0pt}
\setlength{\@fpsep}{12pt plus 1fil}
\setlength{\@fpbot}{0pt plus 1fil}
\makeatother

% Paleta de Okabe e Ito, distinguible con las formas habituales de daltonismo. Cada rol del diagrama
% tiene un color, y además una forma de trazo propia (lleno, grueso, discontinuo): el diagrama sigue
% siendo legible impreso en blanco y negro, porque los rellenos son claros y difieren en luminancia.
\definecolor{figazul}{HTML}{0072B2}
\definecolor{fignaranja}{HTML}{E69F00}
\definecolor{figverde}{HTML}{009E73}
\definecolor{figbermellon}{HTML}{D55E00}
\definecolor{figceleste}{HTML}{56B4E9}
\definecolor{figpurpura}{HTML}{CC79A7}
\colorlet{figtrazo}{black!70}
\colorlet{figrelleno}{black!5}

\tikzset{
    % Recuadro genérico.
    fignodo/.style = {
        draw=figtrazo, rounded corners=2pt, align=center, font=\small,
        inner sep=4pt, minimum height=10mm,
    },
    % Lo que entra al sistema.
    figentrada/.style = {fignodo, draw=figazul!80!black, fill=figazul!12},
    % Una tarea o un componente que transforma.
    figtarea/.style = {fignodo, draw=fignaranja!70!black, fill=fignaranja!18, thick},
    % Lo que sale.
    figsalida/.style = {fignodo, draw=figverde!70!black, fill=figverde!10, densely dashed},
    % Agrupación de componentes; se rotula con label.
    figgrupo/.style = {
        draw=figtrazo, densely dotted, rounded corners=3pt, inner sep=5mm,
        label={[font=\small\itshape, text=figtrazo]above:#1},
    },
    figflecha/.style = {-{Latex[length=2mm, width=1.6mm]}, semithick, figtrazo},
    % Rótulo sobre una flecha.
    figetiqueta/.style = {font=\footnotesize, text=figtrazo, inner sep=2pt, fill=white},
}
