.vscode/

# LaTeX build artifacts in Docs/ — keep the sources, not the output
Docs/**/*
!Docs/**/
!Docs/**/*.tex
!Docs/**/*.pdf
!Docs/**/*.bib
!Docs/**/*.md
# La clase, los paquetes de configuración y la receta de latexmk son fuentes, no
# artefactos: sin ellos un clon nuevo no compila la tesina.
!Docs/**/*.cls
!Docs/**/*.sty
!Docs/TFG/.latexmkrc
!Docs/TFG/Bibliography/*.py
!Docs/**/imagenes/
!Docs/**/imagenes/**
# Plantilla UMU (referencia, no forma parte del documento vivo).
# Tiene que ir después de las negaciones: si va antes, !Docs/**/ la re-incluye.
Docs/TFG/Tesis_Universidad_de_Murcia__UMU_/
# Devoluciones del tutor (transcripciones y PDFs comentados): temporales, no se versionan.
Docs/TFG/feedback/
# Tesina de referencia de otro autor: se consulta, no se versiona.
Docs/tesinamaglione_ejemplo.pdf

# VS Code LaTeX Workshop output folders
Docs/**/${workspaceFolder}/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

