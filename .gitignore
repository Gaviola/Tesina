/Papers
/Libros
Plan_TFG_GAVIOLA_FACUNDO.pdf
.vscode/

# LaTeX build artifacts in Docs/ — keep the sources, not the output
Docs/**/*
!Docs/**/
!Docs/**/*.tex
!Docs/**/*.pdf
!Docs/**/*.bib
!Docs/**/*.md
# La clase, los paquetes de configuración y la receta de latexmk son fuentes, no
# artefactos: sin ellos un clon nuevo no compila la tesina.
!Docs/**/*.cls
!Docs/**/*.sty
!Docs/TFG/.latexmkrc
!Docs/**/imagenes/
!Docs/**/imagenes/**
# Plantilla UMU (referencia, no forma parte del documento vivo).
# Tiene que ir después de las negaciones: si va antes, !Docs/**/ la re-incluye.
Docs/TFG/Tesis_Universidad_de_Murcia__UMU_/
# Devoluciones del tutor (transcripciones y PDFs comentados): temporales, no se versionan.
Docs/TFG/feedback/
# Tesinas de referencia y PDFs comentados en la raíz de Docs: se consultan, no se versionan.
Docs/*.pdf
# Documentos previos a la tesina (propuesta, borradores de marco teórico, estado del arte y
# experimentación, tablas SOTA): la tesina los reemplaza.
Docs/Propuesta/
Docs/estado_del_arte/
Docs/experimentacion/
Docs/marco_teorico/
Docs/tabla_resultados_sota/
# Herramientas de redacción (fichas, guía, referencias pendientes, chequeos de maquetación):
# acompañan la escritura, no forman parte del documento.
Docs/TFG/fichas/
Docs/TFG/guia_redaccion.md
Docs/TFG/refs_pendientes.md

# VS Code LaTeX Workshop output folders
Docs/**/${workspaceFolder}/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# DermVLM data & outputs
Codigo/data/
Codigo/outputs/

# Experiment tracking
wandb/

# Variables de entorno (credenciales de cluster)
.env
Codigo/.env

# Jupyter: los notebooks son exploratorios
.ipynb_checkpoints/
Codigo/notebooks/

# Bitácora de experimentación, notas de trabajo y de los clústeres: solo se versiona la guía de uso.
Codigo/docs/*
!Codigo/docs/USAGE.md
Codigo/*.md
Codigo/*.csv

# Notas de trabajo en la raíz: solo se versiona el README.
/*.md
!/README.md
/*.pdf
# Documentos de trabajo temporales de la revisión de los capítulos 1 y 2.
Docs/TFG/tareas_revision_cap1-2.md
Docs/TFG/candidatos_estado_arte.md
Docs/TFG/lecturas_estado_arte_*.md
